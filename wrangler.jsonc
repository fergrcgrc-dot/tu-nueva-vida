{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "tu-nueva-vida",
  "compatibility_date": "2026-11-04",
  "compatibility_flags": ["nodejs_compat"],
  "main": "src/server.ts",
  "routes": [
    { "pattern": "tunuevavida.eu", "custom_domain": true },
    { "pattern": "www.tunuevavida.eu", "custom_domain": true }
  ]
}
