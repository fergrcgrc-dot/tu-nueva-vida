{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "tu-nueva-vida",
  "compatibility_date": "2026-11-04",
  "compatibility_flags": ["nodejs_compat"],
  "main": "src/server.ts",
  // Logs del Worker en Cloudflare (Workers → tu-nueva-vida → Logs) para vigilar errores y abusos.
  "observability": { "enabled": true, "head_sampling_rate": 1 },
  // Sirve los .html estáticos tal cual (sin redirigir a la URL sin extensión):
  // Google Search Console exige que su archivo de verificación responda 200.
  "assets": { "html_handling": "none" },
  "routes": [
    { "pattern": "tunuevavida.eu", "custom_domain": true },
    { "pattern": "www.tunuevavida.eu", "custom_domain": true }
  ]
}
